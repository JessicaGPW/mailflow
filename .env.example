# MySQL remoto: copie o formato fornecido pelo seu provedor e substitua os valores.
DATABASE_URL=mysql://usuario:senha@host:3306/mailflow
# Defina true se o provedor exigir TLS com certificado confiável pelo sistema.
DATABASE_SSL=false

# Gere valores aleatórios diferentes em cada ambiente; JWT_SECRET precisa ter 32+ caracteres.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres
TRACKING_SECRET=troque-por-outro-segredo-aleatorio-com-no-minimo-32-caracteres

PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
